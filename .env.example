# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SEC_API_USER_AGENT: Required user agent declared to SEC EDGAR (Format: SampleApp/1.0 AdminContact@domain.com)
# This is the ONLY required financial data environment variable for Phase 3.
SEC_API_USER_AGENT="InvestmentIntelligence/1.0 (contact@investment-intelligence.app)"

# MARKET_DATA_API_KEY: Optional legacy alias for US market data.
MARKET_DATA_API_KEY=

# TWELVE_DATA_API_KEY: Optional. Official API Key for Twelve Data (US Equities: NASDAQ, NYSE).
# Server-side only. When absent, US market provider reports UNCONFIGURED and operates in SIMULATED baseline mode.
# When provided, enables live REAL quotes and historical OHLCV from api.twelvedata.com.
TWELVE_DATA_API_KEY=

# TRUEDATA_USERNAME & TRUEDATA_PASSWORD: Optional. Official credentials for TrueData Market Data (India Equities: NSE, BSE).
# Server-side only. When absent, India market provider reports UNCONFIGURED and operates in SIMULATED baseline mode.
# When provided, enables live REAL quotes and historical OHLCV from history.truedata.in.
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=

# FYERS_APP_ID, FYERS_SECRET_KEY, & FYERS_ACCESS_TOKEN: Optional. Official credentials for FYERS Market Data API v3 (India Equities: NSE, BSE).
# Server-side only. Never exposed to the browser.
# When absent, India market provider reports UNCONFIGURED and operates in SIMULATED baseline mode.
# When provided, enables live REAL quotes, batch quotes, and historical OHLCV from api-t1.fyers.in.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

# DATABASE_URL: Target production PostgreSQL database connection string.
# Server-side only. Never exposed to client or browser.
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# When absent, the system initializes the clean disk-backed DevelopmentPersistenceAdapter.
DATABASE_URL=

# FINMAGINE_API_KEY: Optional. Official API Key for Finmagine (Supplemental Research & Fundamental Intelligence).
# Server-side only. Never exposed to browser or client.
# When absent, Finmagine provider reports UNCONFIGURED.
# When provided, enables supplemental fundamental data, ratios, and research intelligence for US and India equities.
FINMAGINE_API_KEY=

